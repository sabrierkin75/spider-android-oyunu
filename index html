<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Spider Android - HTML5 Overlay</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            margin: 0;
            padding: 0;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #1f1f1f;
            font-family: sans-serif;
        }
        #gameCanvas {
            display: block;
            width: 100%;
            height: 100%;
            background-color: #1f1f1f;
        }
        #ui-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }
        .ui-element {
            pointer-events: auto;
        }
        #toggle-ui-btn {
            position: absolute;
            top: 4%;
            right: 5%;
            width: 50px;
            height: 50px;
            background-color: #333f54;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 24px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            z-index: 100;
        }
        #menu-panel {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 85%;
            max-width: 400px;
            background-color: rgba(13, 13, 13, 0.85);
            border-radius: 15px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.5);
            color: white;
        }
        .menu-title {
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            padding: 10px;
            background: rgba(255,255,255,0.05);
            border-radius: 8px;
        }
        .btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: bold;
            color: white;
            text-align: center;
            transition: transform 0.06s ease;
        }
        .btn:active {
            transform: scale(0.95);
        }
        .btn-green { background-color: #21c45d; }
        .btn-red { background-color: #ed4242; }
        .btn-blue { background-color: #333f54; }
        .btn-cyan { background-color: #338099; }
        .setting-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(13,13,13,0.75);
            padding: 6px 10px;
            border-radius: 10px;
        }
        .setting-label {
            font-size: 14px;
            flex: 1;
        }
        .setting-controls {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .ctrl-btn {
            width: 35px;
            height: 35px;
            background-color: #333f54;
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 18px;
            font-weight: bold;
        }
        .ctrl-btn.edge-min { background-color: #ed4242; }
        .ctrl-btn.edge-max { background-color: #21c45d; }
        #about-text {
            font-size: 14px;
            line-height: 1.5;
            text-align: center;
            max-height: 300px;
            overflow-y: auto;
        }
    </style>
</head>
<body>
    <canvas id="gameCanvas"></canvas>
    <div id="ui-container">
        <div id="toggle-ui-btn" class="ui-element">👁️</div>
        <div id="menu-panel" class="ui-element"></div>
    </div>
    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const menuPanel = document.getElementById('menu-panel');
        const toggleUiBtn = document.getElementById('toggle-ui-btn');
        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();
        let uiVisible = true;
        let currentView = "main"; 
        let spiderActive = true;
        let types = ["default", "spider_red", "alien_bug"];
        let currentTypeIdx = 0;
        let config = {
            creature_size: 120,
            move_speed: 4,
            anim_speed: 80,
            max_creatures: 6,
            visual_offset: 15,
            image_facing: 0, 
            super_speed_mult: 3.0,
            bg_image_idx: 0
        };
        function drawProceduralCreature(ctx, size, frame, isSuper, rollAngle, facingMode) {
            ctx.save();
            ctx.translate(size/2, size/2);
            ctx.rotate(rollAngle * Math.PI / 180);
            if (isSuper) {
                let gradient = ctx.createRadialGradient(0,0, size/4, 0,0, size/2);
                gradient.addColorStop(0, 'rgba(255, 215, 0, 0.6)');
                gradient.addColorStop(1, 'rgba(255, 215, 0, 0)');
                ctx.fillStyle = gradient;
                ctx.beginPath();
                ctx.arc(0, 0, size/2, 0, Math.PI*2);
                ctx.fill();
            }
            let bodyColor = "#45b870";
            if (types[currentTypeIdx] === "spider_red") bodyColor = "#ed4242";
            if (types[currentTypeIdx] === "alien_bug") bodyColor = "#9b5de5";
            let legWave = Math.sin(frame * 0.5) * 15;
            ctx.strokeStyle = bodyColor;
            ctx.lineWidth = size * 0.05;
            for (let i = -3; i <= 3; i++) {
                if (i === 0) continue;
                ctx.beginPath();
                ctx.moveTo(0, i * (size * 0.08));
                ctx.quadraticCurveTo(i * (size * 0.3), (i * (size * 0.1)) + legWave, i * (size * 0.4), i * (size * 0.2));
                ctx.stroke();
            }
            ctx.fillStyle = "#111";
            ctx.strokeStyle = bodyColor;
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.arc(0, 0, size * 0.2, 0, Math.PI*2);
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = isSuper ? "#ffd700" : bodyColor;
            ctx.beginPath();
            ctx.arc(size * 0.15, 0, size * 0.08, 0, Math.PI*2);
            ctx.fill();
            ctx.restore();
        }
        class ParticleEmitter {
            constructor() { this.particles = []; }
            spawnShatteredWall(x, y, w, h, color) {
                let count = Math.floor(Math.random() * 20) + 30;
                for (let i = 0; i < count; i++) {
                    this.particles.push({
                        x: x + Math.random() * w, y: y + Math.random() * h,
                        vx: (Math.random() - 0.5) * 200, vy: (Math.random() - 0.5) * 200,
                        size: Math.random() * 12 + 6, color: color,
                        life: 1.5, decay: Math.random() * 1 + 1,
                        rot: Math.random() * 360, rotSpeed: (Math.random() - 0.5) * 180
                    });
                }
            }
            spawnSuperTrail(x, y, size) {
                this.particles.push({
                    x: x + Math.random() * size, y: y + Math.random() * size,
                    vx: (Math.random() - 0.5) * 30, vy: (Math.random() - 0.5) * 30,
                    size: Math.random() * 6 + 6, color: "rgba(255, 215, 0, 0.8)",
                    life: 0.6, decay: 1.5, rot: 0, rotSpeed: 0, isTrail: true
                });
            }
            update(dt) {
                for (let i = this.particles.length - 1; i >= 0; i--) {
                    let p = this.particles[i];
                    p.life -= dt * p.decay;
                    if (p.life <= 0) { this.particles.splice(i, 1); continue; }
                    p.x += p.vx * dt; p.y += p.vy * dt;
                    p.rot += p.rotSpeed * dt;
                    if (p.isTrail) { p.size += dt * 15; }
                }
            }
            draw() {
                this.particles.forEach(p => {
                    ctx.save();
                    ctx.translate(p.x, p.y);
                    ctx.rotate(p.rot * Math.PI / 180);
                    ctx.fillStyle = p.color;
                    ctx.globalAlpha = Math.max(0, p.life);
                    ctx.fillRect(-p.size/2, -p.size/2, p.size, p.size);
                    ctx.restore();
                });
                ctx.globalAlpha = 1.0;
            }
        }
        const particleEmitter = new ParticleEmitter();
        class Creature {
            constructor() {
                this.id = Math.random();
                this.size = config.creature_size;
                this.initPosition();
                this.vx = 0; this.vy = 0;
                this.isGrabbed = false;
                this.isOrbiting = false;
                this.isSuper = false;
                this.superTimer = 0;
                this.frame = 0;
                this.animTime = 0;
                this.rollAngle = 0;
                this.rollSpeed = 0;
            }
            initPosition() {
                let edge = Math.floor(Math.random() * 4);
                if (edge === 0) { this.x = -this.size; this.y = Math.random() * canvas.height; this.angle = (Math.random() - 0.5) * Math.PI/2; }
                else if (edge === 1) { this.x = canvas.width; this.y = Math.random() * canvas.height; this.angle = Math.PI + (Math.random() - 0.5) * Math.PI/2; }
                else if (edge === 2) { this.x = Math.random() * canvas.width; this.y = -this.size; this.angle = Math.PI/2 + (Math.random() - 0.5) * Math.PI/2; }
                else { this.x = Math.random() * canvas.width; this.y = canvas.height; this.angle = -Math.PI/2 + (Math.random() - 0.5) * Math.PI/2; }
            }
            update(dt, spiders, walls) {
                if (this.isGrabbed) return;
                this.animTime += dt;
                if (this.animTime > config.anim_speed / 1000) {
                    this.frame = (this.frame + 1) % 8;
                    this.animTime = 0;
                }
                if (Math.abs(this.rollSpeed) > 0.1) {
                    this.rollAngle += this.rollSpeed * dt;
                    this.rollSpeed *= 0.85;
                } else {
                    this.rollSpeed = 0;
                    if (Math.abs(this.rollAngle) > 0.1) this.rollAngle += (0 - this.rollAngle) * (dt * 8);
                    else this.rollAngle = 0;
                }
                if (this.isSuper) {
                    this.superTimer -= dt;
                    if (this.superTimer <= 0) this.isSuper = false;
                    particleEmitter.spawnSuperTrail(this.x, this.y, this.size);
                }
                let baseSpd = config.move_speed * 30 * (this.isSuper ? config.super_speed_mult : 1.0);
                this.vx = Math.cos(this.angle) * baseSpd;
                this.vy = Math.sin(this.angle) * baseSpd;
                this.x += this.vx * dt;
                this.y += this.vy * dt;
                let r_sz = this.size - (config.visual_offset * 2);
                walls.forEach((wall, idx) => {
                    let r = wall.rect;
                    if (this.x + config.visual_offset < r[0] + r[2] && this.x + config.visual_offset + r_sz > r[0] &&
                        this.y + config.visual_offset < r[1] + r[3] && this.y + config.visual_offset + r_sz > r[1]) {
                        if (this.isSuper) {
                            particleEmitter.spawnShatteredWall(r[0], r[1], r[2], r[3], wall.color);
                            walls.splice(idx, 1);
                        } else {
                            this.angle = (this.angle + Math.PI) % (Math.PI * 2);
                            this.x -= this.vx * dt * 2; this.y -= this.vy * dt * 2;
                        }
                    }
                });
                spiders.forEach(other => {
                    if (other.id === this.id) return;
                    let dx = (other.x + other.size/2) - (this.x + this.size/2);
                    let dy = (other.y + other.size/2) - (this.y + this.size/2);
                    let dist = Math.sqrt(dx*dx + dy*dy);
                    let minDist = (this.size + other.size) / 2 - (config.visual_offset * 2);
                    if (dist < minDist && dist > 0) {
                        if (this.isSuper && !other.isSuper) {
                            other.toRemove = true;
                            particleEmitter.spawnShatteredWall(other.x, other.y, other.size, other.size, "#45b870");
                        } else {
                            this.angle = Math.atan2(-dy, -dx) + (Math.random() - 0.5) * 0.2;
                            this.rollSpeed = 360; 
                        }
                    }
                });
                if (this.x < -100 || this.x > canvas.width + 100 || this.y < -100 || this.y > canvas.height + 100) {
                    this.initPosition();
                }
            }
            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                drawProceduralCreature(ctx, this.size, this.frame, this.isSuper, this.rollAngle, config.image_facing);
                ctx.restore();
            }
        }
        let spiders = [];
        let walls = [];
        let goldOrb = null;
        let goldOrbTimer = 0;
        let wallTimer = 0;
        function spawnRandomWall() {
            if (walls.length >= 3) return;
            let isHz = Math.random() > 0.5;
            let w = isHz ? Math.random() * 250 + 200 : Math.random() * 50 + 40;
            let h = isHz ? Math.random() * 50 + 40 : Math.random() * 250 + 200;
            let x = Math.random() * (canvas.width - w - 100) + 50;
            let y = Math.random() * (canvas.height - h - 200) + 100;
            walls.push({
                rect: [x, y, w, h],
                color: `hsl(${Math.random() * 360}, 70%, 50%)`,
                life: 0
            });
        }
        function spawnGoldOrb() {
            goldOrb = {
                x: Math.random() * (canvas.width - 150) + 50,
                y: Math.random() * (canvas.height - 200) + 100,
                size: 50
            };
        }
        let draggedCreature = null;
        canvas.addEventListener('touchstart', (e) => {
            let touch = e.touches[0];
            let tx = touch.clientX;
            let ty = touch.clientY;
            for (let i = walls.length - 1; i >= 0; i--) {
                let r = walls[i].rect;
                if (tx >= r[0] && tx <= r[0] + r[2] && ty >= r[1] && ty <= r[1] + r[3]) {
                    particleEmitter.spawnShatteredWall(r[0], r[1], r[2], r[3], walls[i].color);
                    walls.splice(i, 1);
                    return;
                }
            }
            spiders.forEach(s => {
                if (tx >= s.x && tx <= s.x + s.size && ty >= s.y && ty <= s.y + s.size) {
                    draggedCreature = s;
                    s.isGrabbed = true;
                }
            });
        });
        canvas.addEventListener('touchmove', (e) => {
            if (draggedCreature) {
                let touch = e.touches[0];
                draggedCreature.x = touch.clientX - draggedCreature.size / 2;
                draggedCreature.y = touch.clientY - draggedCreature.size / 2;
            }
        });
        canvas.addEventListener('touchend', () => {
            if (draggedCreature) {
                draggedCreature.isGrabbed = false;
                draggedCreature.angle = Math.random() * Math.PI * 2;
                draggedCreature = null;
            }
        });
        let aboutSparkles = [];
        function updateAboutSparkles(dt) {
            if (aboutSparkles.length < 10 && Math.random() < 0.05) {
                aboutSparkles.push({
                    x: Math.random() * canvas.width, y: Math.random() * canvas.height,
                    size: Math.random() * 15 + 10, alpha: 0, speed: Math.random() * 2 + 1, state: 'in'
                });
            }
            for (let i = aboutSparkles.length - 1; i >= 0; i--) {
                let s = aboutSparkles[i];
                if (s.state === 'in') {
                    s.alpha += dt * s.speed;
                    if (s.alpha >= 1) s.state = 'out';
                } else {
                    s.alpha -= dt * s.speed;
                    if (s.alpha <= 0) aboutSparkles.splice(i, 1);
                }
            }
        }
        let lastTime = performance.now();
        function gameLoop(now) {
            let dt = (now - lastTime) / 1000;
            if (dt > 0.1) dt = 0.1; 
            lastTime = now;
            ctx.fillStyle = "#121212";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.strokeStyle = "rgba(255,255,255,0.02)";
            ctx.lineWidth = 1;
            for(let x = 0; x < canvas.width; x += 40) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke(); }
            for(let y = 0; y < canvas.height; y += 40) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); }
            if (spiderActive) {
                wallTimer += dt;
                if (wallTimer > 8) { spawnRandomWall(); wallTimer = 0; }
                if (spiders.length >= 4 && !goldOrb) {
                    goldOrbTimer += dt;
                    if (goldOrbTimer > 15) { spawnGoldOrb(); goldOrbTimer = 0; }
                }
                if (goldOrb) {
                    ctx.fillStyle = "rgba(255, 215, 0, 0.3)";
                    ctx.beginPath(); ctx.arc(goldOrb.x, goldOrb.y, goldOrb.size*0.7, 0, Math.PI*2); ctx.fill();
                    ctx.fillStyle = "#ffd700";
                    ctx.beginPath(); ctx.arc(goldOrb.x, goldOrb.y, goldOrb.size*0.4, 0, Math.PI*2); ctx.fill();
                    spiders.forEach(s => {
                        let dx = (s.x + s.size/2) - goldOrb.x;
                        let dy = (s.y + s.size/2) - goldOrb.y;
                        if (Math.sqrt(dx*dx + dy*dy) < s.size/2 + goldOrb.size/2) {
                            s.isSuper = true;
                            s.superTimer = 15;
                            goldOrb = null;
                        }
                    });
                }
                walls.forEach(w => {
                    ctx.fillStyle = w.color;
                    ctx.fillRect(w.rect[0], w.rect[1], w.rect[2], w.rect[3]);
                });
                if (spiders.length < config.max_creatures) spiders.push(new Creature());
                for (let i = spiders.length - 1; i >= 0; i--) {
                    spiders[i].update(dt, spiders, walls);
                    if (spiders[i].toRemove || spiders.length > config.max_creatures) {
                        spiders.splice(i, 1);
                    } else {
                        spiders[i].draw();
                    }
                }
            }
            particleEmitter.update(dt);
            particleEmitter.draw();
            if (currentView === "about") {
                updateAboutSparkles(dt);
                aboutSparkles.forEach(s => {
                    ctx.save(); ctx.globalAlpha = s.alpha; ctx.fillStyle = "#ffd700";
                    ctx.fillRect(s.x, s.y, s.size, 2); ctx.fillRect(s.x + s.size/2 - 1, s.y - s.size/2, 2, s.size);
                    ctx.restore();
                });
                ctx.globalAlpha = 1.0;
            }
            requestAnimationFrame(gameLoop);
        }
        function renderUI() {
            if (!uiVisible) {
                menuPanel.style.display = "none";
                return;
            }
            menuPanel.style.display = "flex";
            if (currentView === "main") {
                menuPanel.innerHTML = `
                    <div class="menu-title" style="color: ${spiderActive ? '#21c45d' : 'white'}">
                        ${spiderActive ? 'Yaratık Yürüyor' : 'Yaratık Duruyor'}
                    </div>
                    <button class="btn ${spiderActive ? 'btn-red' : 'btn-green'}" onclick="toggleSpiderActive()">
                        ${spiderActive ? 'Hareketi Durdur' : 'Hareketi Başlat'}
                    </button>
                    <button class="btn btn-blue" onclick="switchView('settings')">Ayarlar</button>
                    <button class="btn btn-cyan" onclick="switchView('about')">Hakkında</button>
                `;
            } 
            else if (currentView === "settings") {
                menuPanel.innerHTML = `
                    <div class="menu-title">Ayarlar</div>
                    <div class="setting-row">
                        <span class="setting-label">Tür: <b>${types[currentTypeIdx].toUpperCase()}</b></span>
                        <div class="setting-controls">
                            <button class="ctrl-btn" onclick="changeType(-1)">&lt;</button>
                            <button class="ctrl-btn" onclick="changeType(1)">&gt;</button>
                        </div>
                    </div>
                    <div class="setting-row">
                        <span class="setting-label">Boyut: ${config.creature_size} px</span>
                        <div class="setting-controls">
                            <button class="ctrl-btn" onclick="updateConfig('creature_size', -10, 40, 400)">-</button>
                            <button class="ctrl-btn" onclick="updateConfig('creature_size', 10, 40, 400)">+</button>
                        </div>
                    </div>
                    <div class="setting-row">
                        <span class="setting-label">Hız: ${config.move_speed}</span>
                        <div class="setting-controls">
                            <button class="ctrl-btn" onclick="updateConfig('move_speed', -1, 1, 15)">-</button>
                            <button class="ctrl-btn" onclick="updateConfig('move_speed', 1, 1, 15)">+</button>
                        </div>
                    </div>
                    <div class="setting-row">
                        <span class="setting-label">Maks Yaratık: ${config.max_creatures}</span>
                        <div class="setting-controls">
                            <button class="ctrl-btn" onclick="updateConfig('max_creatures', -1, 1, 30)">-</button>
                            <button class="ctrl-btn" onclick="updateConfig('max_creatures', 1, 1, 30)">+</button>
                        </div>
                    </div>
                    <button class="btn btn-green" style="margin-top:10px;" onclick="switchView('main')">Ana Menü</button>
                `;
            } 
            else if (currentView === "about") {
                menuPanel.innerHTML = `
                    <div class="menu-title" style="color:#21c45d">SPIDER ANDROID</div>
                    <div id="about-text">
                        <b>Sürüm:</b> v1.4.0 (HTML5 Edition)<br>
                        <b>Altyapı:</b> Canvas High Performance<br><br>
                        Orijinali Symbian uygulaması olan bu simülasyon, fizik kurallarıyla gezinen yaratıklar içerir.
                    </div>
                    <button class="btn btn-green" onclick="switchView('main')">Ana Menü</button>
                `;
            }
        }
        toggleUiBtn.addEventListener('click', () => {
            uiVisible = !uiVisible;
            toggleUiBtn.innerText = uiVisible ? "👁️" : "❌";
            renderUI();
        });
        window.switchView = function(view) { currentView = view; renderUI(); };
        window.toggleSpiderActive = function() { 
            spiderActive = !spiderActive; 
            if(!spiderActive) { spiders = []; walls = []; goldOrb = null; }
            renderUI(); 
        };
        window.updateConfig = function(key, val, min, max) {
            config[key] = Math.max(min, Math.min(max, config[key] + val));
            if (key === "creature_size") spiders.forEach(s => s.size = config.creature_size);
            renderUI();
        };
        window.changeType = function(dir) {
            currentTypeIdx = (currentTypeIdx + dir + types.length) % types.length;
            renderUI();
        };
        renderUI();
        requestAnimationFrame(gameLoop);
    </script>
</body>
</html>
